# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Server-side HMAC secret for signing session tokens and video stream URLs.
SESSION_SECRET="metafekr-production-hmac-secret-key-change-me"

# ZARINPAL_MERCHANT_ID: 36-character merchant code for ZarinPal payment gateway verification.
# Leave empty until official merchant credentials are provisioned.
ZARINPAL_MERCHANT_ID=""
